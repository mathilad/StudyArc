{
  "expo": {
    "name": "Study Arc",
    "slug": "study-arc",
    "version": "1.1.6",
    "orientation": "default",
    "scheme": "studyarc",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/icon.png",
    "runtimeVersion": "1.1.5",
    "updates": {
      "enabled": true,
      "url": "https://aliqufgpassfhwobjsoh.supabase.co/functions/v1/studyarc-updates",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "./plugins/withStudyTimerService",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080D14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 1,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Study Arc uses your photo library only when you choose a profile picture.",
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.studyarc.app",
      "buildNumber": "16",
      "infoPlist": {
        "UIStatusBarHidden": true,
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "android": {
      "package": "com.studyarc.app",
      "versionCode": 16,
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#080D14"
      }
    },
    "androidStatusBar": {
      "hidden": true,
      "translucent": true,
      "backgroundColor": "#080D14"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": false,
      "baseUrl": "/StudyArc"
    }
  }
}

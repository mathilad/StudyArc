# Authentication database (Supabase)
# Keep authentication, password reset, verification, sessions and account identity here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Application-data database endpoint.
# TEMPORARY: until Cloudflare D1/Worker is created, set these two values to the
# same Supabase URL/key above. Later replace them with the Cloudflare Worker API
# URL and its public client configuration/token as appropriate.
EXPO_PUBLIC_APP_DATABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_APP_DATABASE_KEY=sb_publishable_YOUR_KEY

# Backend selector. `supabase` keeps the current app fully operational while the
# future Cloudflare backend is not provisioned. Change only after the Worker API
# is implemented and deployed.
EXPO_PUBLIC_APP_DATABASE_PROVIDER=supabase

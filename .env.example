# Authentication database (Supabase)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Application-data database endpoint.
EXPO_PUBLIC_APP_DATABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_APP_DATABASE_KEY=sb_publishable_YOUR_KEY
EXPO_PUBLIC_APP_DATABASE_PROVIDER=supabase

# Release delivery (SERVER/GITHUB ACTIONS ONLY — never expose these as EXPO_PUBLIC_*).
# Configure these as GitHub Actions secrets, not in a committed .env file:
# STUDYARC_SUPABASE_URL
# STUDYARC_SUPABASE_SERVICE_ROLE_KEY
# WHATSAPP_ACCESS_TOKEN
# WHATSAPP_PHONE_NUMBER_ID
# WHATSAPP_TEMPLATE_NAME
# Optional GitHub Actions variable: WHATSAPP_TEMPLATE_LANGUAGE=en_US
